    <!-- First run. -->
    <string name="welcome_eyebrow">POCKET EXIT</string>
    <string name="welcome_title">Pair this phone with your computer</string>
    <string name="welcome_lead">Your computer prints a pairing code; scanning it with this phone\'s camera hands over everything the phone needs to become your exit node.</string>
    <string name="welcome_steps_title">How pairing works</string>
    <string name="welcome_step_number">%1$d</string>
    <string name="welcome_step_1_title">Start the server</string>
    <string name="welcome_step_1_detail">Run pocketexit personal on the computer whose traffic you want to send out through this phone.</string>
    <string name="welcome_step_2_title">Scan the code with the camera</string>
    <string name="welcome_step_2_detail">Open the phone\'s ordinary camera app and point it at the code on screen. There is no scanner in here, so there is no camera permission to grant.</string>
    <string name="welcome_step_3_title">Confirm what you see</string>
    <string name="welcome_step_3_detail">Tap the link the camera offers. Pocket Exit shows you the server address and its certificate fingerprint before it sends anything.</string>
    <string name="welcome_safety_title">A link on its own changes nothing</string>
    <string name="welcome_safety_detail">Pairing needs a code the server minted in the last ten minutes, and it needs you to confirm. Until then this phone stores nothing and contacts nobody.</string>
    <string name="welcome_manual">Enter server details manually</string>
    <string name="welcome_manual_hint">For a shared Pocket Exit server, where an administrator handed you a URL and an agent token.</string>

    <!-- Pairing confirmation sheet. -->
    <string name="pair_confirm_title">Pair with this server?</string>
    <string name="pair_confirm_lead">Check that this is your own computer before you continue.</string>
    <string name="pair_label_server">Server address</string>
    <string name="pair_label_name">Server name</string>
    <string name="pair_label_pin">Certificate fingerprint</string>
    <string name="pair_no_name">Not provided</string>
    <string name="pair_pin_none">Not pinned. This server must present a certificate your phone already trusts.</string>
    <string name="pair_pin_full">Full fingerprint %1$s</string>
    <string name="pair_consent">Confirming sends this phone\'s name, %1$s, to %2$s. Nothing is written to this phone until that server answers.</string>
    <string name="pair_confirm_action">Pair this phone</string>
    <string name="pair_working_title">Pairing</string>
