    <string name="pair_link_unreadable">This is not a usable Pocket Exit link.</string>
    <string name="pair_link_rejected_hint">Mint a fresh code on the server and scan it again.</string>
    <string name="pair_import_title">Import this configuration?</string>
    <string name="pair_import_lead">This link carries an agent token that an administrator minted for you.</string>
    <string name="pair_import_note">The exit node stays stopped until you start it.</string>
