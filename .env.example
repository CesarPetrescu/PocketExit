# Public DNS name or IP clients use for SOCKS5 UDP relay replies.
PUBLIC_PROXY_HOST=proxy.example.com

# Replace every credential before publishing any port.
ADMIN_TOKEN=replace-with-a-long-random-admin-token
SOCKS_USERNAME=proxy
SOCKS_PASSWORD=replace-with-a-long-random-socks-password

# One unique token per Android installation.
AGENT_TOKENS_JSON={"s20u":"replace-s20u-token","s22u":"replace-s22u-token","s24u":"replace-s24u-token"}

HTTP_ADDR=:8080
SOCKS_ADDR=:1080
UDP_BIND_HOST=0.0.0.0
UDP_PORT_START=12000
UDP_PORT_END=12031
NODE_OFFLINE_AFTER=45s
COMMAND_WAIT=25s
OPEN_TIMEOUT=15s
IDLE_TIMEOUT=2m
MAX_CIRCUITS_PER_NODE=128

# False blocks loopback, RFC1918, link-local, multicast, documentation ranges,
# and cloud metadata-style destinations. Keep false for an Internet exit pool.
ALLOW_PRIVATE_DESTINATIONS=false
LOG_JSON=true
LOG_LEVEL=info

# Bearer token created by the site's SparkTunnel deployment settings.
SPARK_TUNNEL_TOKEN=replace-with-the-one-time-connector-token
